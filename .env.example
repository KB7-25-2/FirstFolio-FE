# API
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000
# 관리자 API (미설정 시 VITE_API_* 사용)
# VITE_ADMIN_API_BASE_URL=/api
# VITE_ADMIN_API_TIMEOUT=15000

# Auth
VITE_TOKEN_KEY=access_token

# Dev proxy target (vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:8080

# Firebase (Firebase Console > 프로젝트 설정 > 일반 > 웹 앱)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=   # Analytics 사용 시
